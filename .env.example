HOST=127.0.0.1
PORT=5002
AGENDAE_SITE_URL=https://agendaê.app
DATA_DIR=./data
WHATSAPP_AUTH_DIR=./.wwebjs_auth
# Obrigatório se HOST expuser o painel na rede. Use HTTPS no proxy reverso.
ADMIN_TOKEN=
# Opcional: caminho para um Chrome instalado no servidor.
CHROME_EXECUTABLE_PATH=
# Ative somente se o ambiente exigir a desativação do sandbox do navegador.
CHROME_NO_SANDBOX=false
